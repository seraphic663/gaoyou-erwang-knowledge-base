{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "annotation_case.v1.schema.json",
  "title": "Erwang Annotation Case v1",
  "type": "object",
  "required": [
    "schema_version",
    "case_title",
    "submitted_by",
    "source_work",
    "target_work",
    "target_text",
    "term_relations",
    "evidences",
    "conclusion"
  ],
  "properties": {
    "schema_version": {"const": "annotation_case.v1"},
    "case_id": {"type": ["string", "null"]},
    "case_title": {"type": "string", "minLength": 1},
    "submitted_by": {"type": "string", "minLength": 1},
    "reviewed_by": {"type": ["string", "null"]},
    "source_work": {"type": "string", "minLength": 1},
    "source_passage_id": {"type": ["string", "null"]},
    "source_location": {"type": ["object", "null"]},
    "target_work": {"type": "string", "minLength": 1},
    "target_text": {"type": "string", "minLength": 1},
    "target_location": {"type": ["object", "null"]},
    "term_relations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_term", "target_term"],
        "properties": {
          "source_term": {"type": "string", "minLength": 1},
          "target_term": {"type": "string", "minLength": 1},
          "relation_type": {
            "type": ["string", "null"],
            "enum": ["训释", "校勘", "字际关系", "虚词用法", "句义解释", "未定", null]
          },
          "relation_subtype": {"type": ["string", "null"]},
          "relation_note": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "evidences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["quote"],
        "properties": {
          "quote": {"type": "string", "minLength": 1},
          "evidence_role": {"type": ["string", "null"]},
          "source_work": {"type": ["string", "null"]},
          "passage_id": {"type": ["string", "null"]},
          "quote_start_char": {"type": ["integer", "null"], "minimum": 0},
          "quote_end_char": {"type": ["integer", "null"], "minimum": 0},
          "quote_sha256": {"type": ["string", "null"]},
          "quote_check": {
            "type": ["string", "null"],
            "enum": ["unchecked", "passed", "failed", "normalized_passed", null]
          }
        },
        "additionalProperties": true
      }
    },
    "problem_discovery": {"type": ["string", "null"]},
    "research_question": {"type": ["string", "null"]},
    "evidence_collection": {"type": ["string", "null"]},
    "reasoning": {"type": ["string", "null"]},
    "conclusion": {"type": "string", "minLength": 1},
    "method_profile": {"type": ["object", "null"]},
    "machine_result": {
      "type": ["object", "null"],
      "properties": {
        "status": {"enum": ["pending", "draft", "approved", "rejected", null]}
      },
      "additionalProperties": true
    },
    "human_review": {
      "type": ["object", "null"],
      "properties": {
        "status": {"enum": ["pending", "approved", "rejected", "uncertain", null]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
