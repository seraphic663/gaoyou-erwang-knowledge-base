      "process_steps": [
        {
          "step_type": "立论",
          "text": "明确所列13字均训为“敬”。",
          "source_paragraph_indexes": [
            68,
            69
          ],
          "source_comment_ids": []
        },
        {
          "step_type": "取证",
          "text": "①虔：引《殷武》传直训，辅以《韩奕》用例。",
          "source_paragraph_indexes": [
            71
          ],
          "source_comment_ids": []
        },
        {
          "step_type": "释词",
          "text": "②畏：引《大学》《表记》，提出威与畏通。补郑注、《孟子》用例。",
          "source_paragraph_indexes": [
            72
          ],
          "source_comment_ids": []
        },
        {
          "step_type": "释词",
          "text": "③宾：引《说文》直训，引郑众注，引《礼运》儐鬼神及《释文》证儐与宾通。",
          "source_paragraph_indexes": [
            73
          ],
          "source_comment_ids": []
        },
        {
          "step_type": "释词",
          "text": "④斋：引《采蘋》毛传，提出齐与斋通。",
          "source_paragraph_indexes": [
            74
          ],
          "source_comment_ids": []
        },
        {
          "step_type": "释词",
          "text": "⑤亟：从《说文》敬字溯源，引《玉篇》苟亦作亟，引《说文》㥛，补《成阳灵台碑》，证苟、亟、革、㥛同义。",
          "source_paragraph_indexes": [
            75
          ],
          "source_comment_ids": []
        },
        {
          "step_type": "释词",
          "text": "⑥憼：《说文》直训，引郑笺“敬之言警”，声近义同。",
          "source_paragraph_indexes": [
            76
          ],
          "source_comment_ids": []
        },
        {
          "step_type": "释词",
          "text": "⑦-⑧懍、浚：引《方言》证稟、浚有敬义，稟与懍通。",
          "source_paragraph_indexes": [
            77
          ],
          "source_comment_ids": []
        },
        {
          "step_type": "释词",
          "text": "⑨悛：引《说文》恮，证恮与悛通；又悛亦浚也，引《论语》《史记》证声近义同。",
          "source_paragraph_indexes": [
            78
          ],
          "source_comment_ids": []
        },
        {
          "step_type": "释词",
          "text": "⑩-11诚、信：引《祭统》证诚、信、尽、敬义理关联。",
          "source_paragraph_indexes": [
            79
          ],
          "source_comment_ids": []
        },
        {
          "step_type": "结论",
          "text": "通过经传注疏、小学专书、方言、碑刻等材料，结合通假、声近义同、同义互证等，逐一证明这些字词均含恭敬义，构建敬义字词系统。",
          "source_paragraph_indexes": [
            82
          ],
