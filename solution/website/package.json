  "description": "高邮二王考据过程知识库构建及应用专题整理原型",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "machine:build": "python scripts/machine_library.py build",
